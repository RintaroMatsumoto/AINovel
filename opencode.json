{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/rules/story-consistency.md",
    ".agents/rules/story-format.md",
    ".agents/rules/story-narrative.md",
    ".agents/rules/story-outline.md"
  ],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true,
      "env": {
        "MEMORY_FILE_PATH": "C:\\Users\\GoldRush\\Documents\\MyProject\\AINovel\\.memory\\memory.json"
      }
    },
    "filesystem": {
      "type": "local",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\GoldRush\\Documents\\MyProject\\AINovel"
      ],
      "enabled": true
    }
  }
}
